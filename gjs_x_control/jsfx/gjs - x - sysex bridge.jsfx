desc:GJS - X - SysEx Bridge
options:gmem=GJS_X_BRIDGE

// ============================================================
// gmem-indeling
//
// gmem[0] = sequence
// gmem[1] = command
// gmem[2] = laatst bevestigde sequence
//
// Command 3:
// gmem[3] = LED-index / MIDI-noot
// gmem[4] = rood   0-127
// gmem[5] = groen  0-127
// gmem[6] = blauw  0-127
// ============================================================


@init

last_sequence = -1;

// Twee losse geheugenbuffers voor SysEx
buf_midi = 0;
buf_daw = 128;



// ============================================================
// Screen-7 performance rendering (owned by the hardware bridge)
// ============================================================
PERFORMANCE_SCREEN_SLOT = 100;
PERF_LAYOUT_SLOT = 1200;
PERF_OCTAVE_SLOT = 1201;
PERF_REDRAW_SLOT = 1202;
PERF_FEEDBACK_SEQ_SLOT = 1203;
PERF_FEEDBACK_NOTE_SLOT = 1204;
PERF_FEEDBACK_STATE_SLOT = 1205;
last_perf_layout = -1;
last_perf_octave = 999;
last_perf_redraw = -1;
last_perf_feedback_seq = -1;

function perf_clamp(v) ( max(0,min(127,floor(v))); );

function perf_write_rgb(buffer,target,led,r,g,b) (
    buffer[target]=$x03;
    buffer[target+1]=perf_clamp(led);
    buffer[target+2]=perf_clamp(r);
    buffer[target+3]=perf_clamp(g);
    buffer[target+4]=perf_clamp(b);
);

function perf_drum_rgb(note,component) local(row,col,r,g,b) (
    row=floor(note/10); col=note%10; r=0; g=0; b=0;
    (row==7 && (col==4 || col==5)) || (row==6 && (col==4 || col==5)) ? (r=127;b=80;);
    row==5 ? (
        col==2 || col==7 ? (r=127;g=127;b=127;);
        col==3 || col==6 ? (r=127;g=110;);
        col==4 ? (r=127;b=80;);
        col==5 ? (r=60;b=127;);
    );
    row==4 ? (
        col==2 || col==7 ? g=127;
        col==3 || col==6 ? b=127;
        col==4 || col==5 ? (g=70;b=127;);
    );
    row==3 ? (
        col==2 || col==7 ? (r=127;g=40;);
        col==4 || col==5 ? (r=127;g=110;);
    );
    row==2 ? (
        col==2 || col==7 ? (r=75;g=25;b=127;);
        col==4 || col==5 ? (r=127;g=40;);
    );
    row==1 && (col==4 || col==5) ? r=55;
    component==1?r:component==2?g:b;
);

function perf_piano_key(note) local(row,col,pair,semi,valid) (
    row=floor(note/10); col=note%10; pair=floor((row-1)/2); semi=-1; valid=0;
    row%2==1 ? (
        col==1?semi=0:col==2?semi=2:col==3?semi=4:col==4?semi=5:col==5?semi=7:col==6?semi=9:col==7?semi=11:col==8?semi=12;
        valid=1;
    ) : (
        col==2?semi=1:col==3?semi=3:col==5?semi=6:col==6?semi=8:col==7?semi=10;
        semi>=0 ? valid=1;
    );
    valid ? pair*12+semi : -1;
);

function perf_send_one(led,r,g,b) local(len) (
    buf_perf_midi=1400; buf_perf_daw=1440;
    buf_perf_midi[0]=$xF0;buf_perf_midi[1]=$x00;buf_perf_midi[2]=$x20;buf_perf_midi[3]=$x29;buf_perf_midi[4]=$x02;buf_perf_midi[5]=$x0D;buf_perf_midi[6]=$x03;
    buf_perf_daw[0]=$xF0;buf_perf_daw[1]=$x00;buf_perf_daw[2]=$x20;buf_perf_daw[3]=$x29;buf_perf_daw[4]=$x02;buf_perf_daw[5]=$x0C;buf_perf_daw[6]=$x03;
    perf_write_rgb(buf_perf_midi,7,led,r,g,b);perf_write_rgb(buf_perf_daw,7,led,r,g,b);
    buf_perf_midi[12]=$xF7;buf_perf_daw[12]=$xF7;
    midisend_buf(0,buf_perf_midi,13);midisend_buf(0,buf_perf_daw,13);
);

function perf_base_rgb(note,layout,component) local(k,r,g,b) (
    r=0;g=0;b=0;
    layout==1 ? (r=perf_drum_rgb(note,1);g=perf_drum_rgb(note,2);b=perf_drum_rgb(note,3);) :
    layout==2 ? (
        note==41 || note==48 ? (r=127;g=127;b=0;) : ( // transpose = yellow
            note==21 || note==28 ? (r=0;g=127;b=0;) : ( // octave = green
                k=perf_piano_key(note); k>=0 ? (b=22;);
            );
        );
    );
    component==1?r:component==2?g:b;
);

function perf_draw_layout(layout) local(i,row,col,n,target,r,g,b,len) (
    buf_pm=1600;buf_pd=2000;
    buf_pm[0]=$xF0;buf_pm[1]=$x00;buf_pm[2]=$x20;buf_pm[3]=$x29;buf_pm[4]=$x02;buf_pm[5]=$x0D;buf_pm[6]=$x03;
    buf_pd[0]=$xF0;buf_pd[1]=$x00;buf_pd[2]=$x20;buf_pd[3]=$x29;buf_pd[4]=$x02;buf_pd[5]=$x0C;buf_pd[6]=$x03;
    i=0; loop(64,
        row=floor(i/8)+1;col=(i%8)+1;n=row*10+col;target=7+i*5;
        r=perf_base_rgb(n,layout,1);g=perf_base_rgb(n,layout,2);b=perf_base_rgb(n,layout,3);
        perf_write_rgb(buf_pm,target,n,r,g,b);perf_write_rgb(buf_pd,target,n,r,g,b);i+=1;
    );
    len=8+64*5;buf_pm[len-1]=$xF7;buf_pd[len-1]=$xF7;
    midisend_buf(0,buf_pm,len);midisend_buf(0,buf_pd,len);
);

// ============================================================
// Sequencer / main-bar realtime rendering
// Integrated from the former "gjs - x - sequencer display.jsfx".
// This bridge is now the single Launchpad hardware writer.
//
// gmem[300] = display mode: 0 off, 1 sequencer, 2 mainscreen bars
// gmem[301] = selected bar, 1-based
// gmem[302] = selected region start in quarter notes
// gmem[303] = selected region length in bars
// gmem[304] = pattern version
// gmem[305] = force redraw version
// gmem[306] = active sixteenth-note steps in selected measure
// gmem[307] = mainscreen current bar
// gmem[308] = mainscreen transport active
// gmem[316]..gmem[331] = velocity/state for steps 1..16
// gmem[332] = active subproject number
// ============================================================

SEQ_GMEM_BASE = 300;
seq_last_enabled = -1;
seq_last_mode = -1;
seq_last_bar = -1;
seq_last_pattern_version = -1;
seq_last_force_version = -1;
seq_last_step = -2;
seq_last_playing = -1;
seq_last_clock_heartbeat = -1;
seq_last_active_project = -1;
seq_last_region_bars = -1;
seq_last_current_bar = -1;
seq_last_active_steps = -1;
seq_last_main_config_version = -1;
seq_last_clock_config_version = -1;

// Dedicated buffers avoid clashing with command/performance buffers.
seq_buf_midi = 3000;
seq_buf_daw = 3400;

function seq_clamp127(value) (
    max(0, min(127, floor(value)));
);

function seq_step_led(step) local(row, col) (
    step <= 8 ? (
        row = 8;
        col = step;
    ) : (
        row = 7;
        col = step - 8;
    );
    row * 10 + col;
);

function seq_get_background(bar, component) local(cycle) (
    cycle = ((bar - 1) % 4) + 1;
    cycle == 1 ? (
        component == 1 ? 0 : component == 2 ? 10 : 0;
    ) : cycle == 2 ? (
        component == 1 ? 12 : component == 2 ? 3 : 0;
    ) : cycle == 3 ? (
        component == 1 ? 0 : component == 2 ? 4 : 20;
    ) : (
        component == 1 ? 8 : component == 2 ? 0 : 18;
    );
);

function seq_get_playhead(bar, component) local(cycle) (
    cycle = ((bar - 1) % 4) + 1;
    cycle == 1 ? (
        component == 1 ? 0 : component == 2 ? 127 : 0;
    ) : cycle == 2 ? (
        component == 1 ? 127 : component == 2 ? 35 : 0;
    ) : cycle == 3 ? (
        component == 1 ? 0 : component == 2 ? 45 : 127;
    ) : (
        component == 1 ? 75 : component == 2 ? 25 : 127;
    );
);

function seq_write_rgb_spec(buffer, target, led, red, green, blue) (
    buffer[target + 0] = $x03;
    buffer[target + 1] = seq_clamp127(led);
    buffer[target + 2] = seq_clamp127(red);
    buffer[target + 3] = seq_clamp127(green);
    buffer[target + 4] = seq_clamp127(blue);
);

function seq_send_display(selected_bar, current_step, playing)
local(i, target, led, velocity, red, green, blue, note_here, other_note_here,
      playhead_here, message_length, active_steps) (
    seq_buf_midi[0] = $xF0; seq_buf_midi[1] = $x00; seq_buf_midi[2] = $x20;
    seq_buf_midi[3] = $x29; seq_buf_midi[4] = $x02; seq_buf_midi[5] = $x0D;
    seq_buf_midi[6] = $x03;

    seq_buf_daw[0] = $xF0; seq_buf_daw[1] = $x00; seq_buf_daw[2] = $x20;
    seq_buf_daw[3] = $x29; seq_buf_daw[4] = $x02; seq_buf_daw[5] = $x0C;
    seq_buf_daw[6] = $x03;

    active_steps = max(1, min(16, floor(gmem[SEQ_GMEM_BASE + 6])));
    i = 0;
    loop(16,
        target = 7 + (i * 5);
        led = seq_step_led(i + 1);
        velocity = floor(gmem[SEQ_GMEM_BASE + 16 + i]);
        other_note_here = velocity >= 256;
        note_here = velocity > 0 && velocity < 256;
        playhead_here = playing && current_step == i + 1;

        i + 1 > active_steps ? (
            red = 0; green = 0; blue = 0;
            note_here = 0; playhead_here = 0;
        ) : (
            red = seq_get_background(selected_bar, 1);
            green = seq_get_background(selected_bar, 2);
            blue = seq_get_background(selected_bar, 3);
        );

        other_note_here && i + 1 <= active_steps ? (
            red = min(127, seq_get_background(selected_bar, 1) * 3);
            green = min(127, seq_get_background(selected_bar, 2) * 3);
            blue = min(127, seq_get_background(selected_bar, 3) * 3);
        );

        note_here ? (
            red = max(30, velocity); green = 0; blue = 0;
        );

        playhead_here ? (
            note_here ? (
                red = 127; green = 127; blue = 127;
            ) : (
                red = seq_get_playhead(selected_bar, 1);
                green = seq_get_playhead(selected_bar, 2);
                blue = seq_get_playhead(selected_bar, 3);
            );
        );

        seq_write_rgb_spec(seq_buf_midi, target, led, red, green, blue);
        seq_write_rgb_spec(seq_buf_daw, target, led, red, green, blue);
        i += 1;
    );

    message_length = 8 + (16 * 5);
    seq_buf_midi[message_length - 1] = $xF7;
    seq_buf_daw[message_length - 1] = $xF7;
    midisend_buf(0, seq_buf_midi, message_length);
    midisend_buf(0, seq_buf_daw, message_length);
);

function seq_send_main_display(region_bars, previous_region_bars, current_bar, playing)
local(i, count, target, led, red, green, blue, active_bar, message_length) (
    count = max(region_bars, previous_region_bars);
    count = max(0, min(16, count));

    count > 0 ? (
        seq_buf_midi[0] = $xF0; seq_buf_midi[1] = $x00; seq_buf_midi[2] = $x20;
        seq_buf_midi[3] = $x29; seq_buf_midi[4] = $x02; seq_buf_midi[5] = $x0D;
        seq_buf_midi[6] = $x03;

        seq_buf_daw[0] = $xF0; seq_buf_daw[1] = $x00; seq_buf_daw[2] = $x20;
        seq_buf_daw[3] = $x29; seq_buf_daw[4] = $x02; seq_buf_daw[5] = $x0C;
        seq_buf_daw[6] = $x03;

        i = 0;
        loop(count,
            target = 7 + (i * 5);
            led = seq_step_led(i + 1);
            active_bar = i + 1;

            active_bar <= region_bars ? (
                red = 83; green = 20; blue = 20;
                playing && active_bar == current_bar ? (
                    red = 127; green = 0; blue = 0;
                );
            ) : (
                red = 32; green = 32; blue = 32;
            );

            seq_write_rgb_spec(seq_buf_midi, target, led, red, green, blue);
            seq_write_rgb_spec(seq_buf_daw, target, led, red, green, blue);
            i += 1;
        );

        message_length = 8 + (count * 5);
        seq_buf_midi[message_length - 1] = $xF7;
        seq_buf_daw[message_length - 1] = $xF7;
        midisend_buf(0, seq_buf_midi, message_length);
        midisend_buf(0, seq_buf_daw, message_length);
    );
);

@block

sequence = floor(gmem[0]);

sequence != last_sequence ? (
    last_sequence = sequence;
    command = floor(gmem[1]);


    // ========================================================
    // Command 1: Programmer Mode
    // ========================================================

    command == 1 ? (

        // Normale MIDI-interface:
        // F0 00 20 29 02 0D 0E 01 F7

        buf_midi[0] = $xF0;
        buf_midi[1] = $x00;
        buf_midi[2] = $x20;
        buf_midi[3] = $x29;
        buf_midi[4] = $x02;
        buf_midi[5] = $x0D;
        buf_midi[6] = $x0E;
        buf_midi[7] = $x01;
        buf_midi[8] = $xF7;

        midisend_buf(0, buf_midi, 9);


        // DAW-interface:
        // F0 00 20 29 02 0C 0E 01 F7

        buf_daw[0] = $xF0;
        buf_daw[1] = $x00;
        buf_daw[2] = $x20;
        buf_daw[3] = $x29;
        buf_daw[4] = $x02;
        buf_daw[5] = $x0C;
        buf_daw[6] = $x0E;
        buf_daw[7] = $x01;
        buf_daw[8] = $xF7;

        midisend_buf(0, buf_daw, 9);

        gmem[2] = sequence;
    );


    // ========================================================
    // Command 2: Live Mode
    // ========================================================

    command == 2 ? (

        // Normale MIDI-interface:
        // F0 00 20 29 02 0D 0E 00 F7

        buf_midi[0] = $xF0;
        buf_midi[1] = $x00;
        buf_midi[2] = $x20;
        buf_midi[3] = $x29;
        buf_midi[4] = $x02;
        buf_midi[5] = $x0D;
        buf_midi[6] = $x0E;
        buf_midi[7] = $x00;
        buf_midi[8] = $xF7;

        midisend_buf(0, buf_midi, 9);


        // DAW-interface:
        // F0 00 20 29 02 0C 0E 00 F7

        buf_daw[0] = $xF0;
        buf_daw[1] = $x00;
        buf_daw[2] = $x20;
        buf_daw[3] = $x29;
        buf_daw[4] = $x02;
        buf_daw[5] = $x0C;
        buf_daw[6] = $x0E;
        buf_daw[7] = $x00;
        buf_daw[8] = $xF7;

        midisend_buf(0, buf_daw, 9);

        gmem[2] = sequence;
    );


    // ========================================================
    // Command 3: één LED instellen met RGB
    // ========================================================

    command == 3 ? (

        led_index = floor(gmem[3]);
        red       = floor(gmem[4]);
        green     = floor(gmem[5]);
        blue      = floor(gmem[6]);

        // Veilig begrenzen
        led_index = max(0, min(127, led_index));
        red       = max(0, min(127, red));
        green     = max(0, min(127, green));
        blue      = max(0, min(127, blue));


        // ----------------------------------------------------
        // Normale MIDI-interface:
        //
        // F0 00 20 29 02 0D 03
        // 03 <led> <r> <g> <b>
        // F7
        // ----------------------------------------------------

        buf_midi[0]  = $xF0;
        buf_midi[1]  = $x00;
        buf_midi[2]  = $x20;
        buf_midi[3]  = $x29;
        buf_midi[4]  = $x02;
        buf_midi[5]  = $x0D;
        buf_midi[6]  = $x03;

        // Colourspec
        buf_midi[7]  = $x03;      // RGB lighting type
        buf_midi[8]  = led_index;
        buf_midi[9]  = red;
        buf_midi[10] = green;
        buf_midi[11] = blue;

        buf_midi[12] = $xF7;

        midisend_buf(0, buf_midi, 13);


        // ----------------------------------------------------
        // DAW-interface:
        //
        // F0 00 20 29 02 0C 03
        // 03 <led> <r> <g> <b>
        // F7
        // ----------------------------------------------------

        buf_daw[0]  = $xF0;
        buf_daw[1]  = $x00;
        buf_daw[2]  = $x20;
        buf_daw[3]  = $x29;
        buf_daw[4]  = $x02;
        buf_daw[5]  = $x0C;
        buf_daw[6]  = $x03;

        // Colourspec
        buf_daw[7]  = $x03;
        buf_daw[8]  = led_index;
        buf_daw[9]  = red;
        buf_daw[10] = green;
        buf_daw[11] = blue;

        buf_daw[12] = $xF7;

        midisend_buf(0, buf_daw, 13);

        gmem[2] = sequence;
    );

    // ========================================================
    // Command 4: volledige fader van 8 RGB-leds
    // ========================================================

    command == 4 ? (

        led_count = floor(gmem[10]);

        // Normale MIDI-interface
        buf_midi[0] = $xF0;
        buf_midi[1] = $x00;
        buf_midi[2] = $x20;
        buf_midi[3] = $x29;
        buf_midi[4] = $x02;
        buf_midi[5] = $x0D;
        buf_midi[6] = $x03;

        // DAW-interface
        buf_daw[0] = $xF0;
        buf_daw[1] = $x00;
        buf_daw[2] = $x20;
        buf_daw[3] = $x29;
        buf_daw[4] = $x02;
        buf_daw[5] = $x0C;
        buf_daw[6] = $x03;

        i = 0;

        loop(led_count,
            source = 11 + (i * 4);
            target = 7 + (i * 5);

            led_index = floor(gmem[source + 0]);
            red       = floor(gmem[source + 1]);
            green     = floor(gmem[source + 2]);
            blue      = floor(gmem[source + 3]);

            // Eén RGB colourspec
            buf_midi[target + 0] = $x03;
            buf_midi[target + 1] = led_index;
            buf_midi[target + 2] = red;
            buf_midi[target + 3] = green;
            buf_midi[target + 4] = blue;

            buf_daw[target + 0] = $x03;
            buf_daw[target + 1] = led_index;
            buf_daw[target + 2] = red;
            buf_daw[target + 3] = green;
            buf_daw[target + 4] = blue;

            i += 1;
        );

        message_length = 8 + (led_count * 5);

        buf_midi[message_length - 1] = $xF7;
        buf_daw[message_length - 1]  = $xF7;

        midisend_buf(0, buf_midi, message_length);
        midisend_buf(0, buf_daw, message_length);

        gmem[2] = sequence;
    );



    // ========================================================
    // Command 5: volledige 8x8 RGB-matrix (maximaal 64 leds)
    //
    // gmem[10] = aantal leds (0-64)
    // Vanaf gmem[11], per led vier waarden:
    //   led-index, rood, groen, blauw
    //
    // Deze uitbreiding verandert de bestaande commands 1-4 niet.
    // ========================================================

    command == 5 ? (

        led_count = floor(gmem[10]);
        led_count = max(0, min(64, led_count));

        // Aparte grote buffers. Een matrixbericht kan 328 bytes zijn.
        buf_matrix_midi = 256;
        buf_matrix_daw  = 768;

        // Normale MIDI-interface
        buf_matrix_midi[0] = $xF0;
        buf_matrix_midi[1] = $x00;
        buf_matrix_midi[2] = $x20;
        buf_matrix_midi[3] = $x29;
        buf_matrix_midi[4] = $x02;
        buf_matrix_midi[5] = $x0D;
        buf_matrix_midi[6] = $x03;

        // DAW-interface
        buf_matrix_daw[0] = $xF0;
        buf_matrix_daw[1] = $x00;
        buf_matrix_daw[2] = $x20;
        buf_matrix_daw[3] = $x29;
        buf_matrix_daw[4] = $x02;
        buf_matrix_daw[5] = $x0C;
        buf_matrix_daw[6] = $x03;

        i = 0;

        loop(led_count,
            source = 11 + (i * 4);
            target = 7 + (i * 5);

            led_index = floor(gmem[source + 0]);
            red       = floor(gmem[source + 1]);
            green     = floor(gmem[source + 2]);
            blue      = floor(gmem[source + 3]);

            led_index = max(0, min(127, led_index));
            red       = max(0, min(127, red));
            green     = max(0, min(127, green));
            blue      = max(0, min(127, blue));

            buf_matrix_midi[target + 0] = $x03;
            buf_matrix_midi[target + 1] = led_index;
            buf_matrix_midi[target + 2] = red;
            buf_matrix_midi[target + 3] = green;
            buf_matrix_midi[target + 4] = blue;

            buf_matrix_daw[target + 0] = $x03;
            buf_matrix_daw[target + 1] = led_index;
            buf_matrix_daw[target + 2] = red;
            buf_matrix_daw[target + 3] = green;
            buf_matrix_daw[target + 4] = blue;

            i += 1;
        );

        message_length = 8 + (led_count * 5);

        buf_matrix_midi[message_length - 1] = $xF7;
        buf_matrix_daw[message_length - 1]  = $xF7;

        midisend_buf(0, buf_matrix_midi, message_length);
        midisend_buf(0, buf_matrix_daw, message_length);

        gmem[2] = sequence;
    );

);

// Screen-7 layout and feedback are sent by this JSFX because this bridge is
// the one routed to the Launchpad hardware outputs.
perf_screen = floor(gmem[PERFORMANCE_SCREEN_SLOT]) == 1;
perf_layout = perf_screen ? floor(gmem[PERF_LAYOUT_SLOT]) : 0;
perf_octave = floor(gmem[PERF_OCTAVE_SLOT]);
perf_redraw = floor(gmem[PERF_REDRAW_SLOT]);

(perf_layout != last_perf_layout || perf_octave != last_perf_octave || perf_redraw != last_perf_redraw) ? (
    // IMPORTANT: never clear the 8x8 matrix when leaving performance mode.
    // Lua has already drawn (or is about to draw) the destination screen, and
    // a delayed perf_draw_layout(0) would race it and blank that screen.
    perf_screen ? perf_draw_layout(perf_layout);
    last_perf_layout=perf_layout;last_perf_octave=perf_octave;last_perf_redraw=perf_redraw;
);

perf_feedback_seq=floor(gmem[PERF_FEEDBACK_SEQ_SLOT]);
perf_feedback_seq != last_perf_feedback_seq ? (
    last_perf_feedback_seq=perf_feedback_seq;
    // Ignore stale press/release feedback after screen 7 has been left.
    perf_screen ? (
        perf_note=floor(gmem[PERF_FEEDBACK_NOTE_SLOT]);
        perf_pressed=floor(gmem[PERF_FEEDBACK_STATE_SLOT]);
        perf_pressed ? perf_send_one(perf_note,127,0,0) : (
            perf_send_one(perf_note,
                perf_base_rgb(perf_note,perf_layout,1),
                perf_base_rgb(perf_note,perf_layout,2),
                perf_base_rgb(perf_note,perf_layout,3));
        );
    );
);

// ============================================================
// Realtime sequencer/main-bar engine
// Runs AFTER normal Lua commands/performance feedback in this same @block,
// so rows 7/8 have one deterministic final writer.
// ============================================================
seq_mode = floor(gmem[SEQ_GMEM_BASE + 0]);
seq_enabled = seq_mode > 0;
seq_selected_bar = max(1, floor(gmem[SEQ_GMEM_BASE + 1]));
seq_region_start_qn = gmem[SEQ_GMEM_BASE + 2];
seq_region_bars = max(0, floor(gmem[SEQ_GMEM_BASE + 3]));
seq_pattern_version = floor(gmem[SEQ_GMEM_BASE + 4]);
seq_force_version = floor(gmem[SEQ_GMEM_BASE + 5]);
seq_display_active_steps = max(1, min(16, floor(gmem[SEQ_GMEM_BASE + 6])));

seq_active_project = max(0, min(8, floor(gmem[332])));
seq_clock_stride = 5;
seq_clock_base = 340 + ((max(1, seq_active_project) - 1) * seq_clock_stride);
seq_clock_heartbeat = seq_active_project > 0 ? floor(gmem[seq_clock_base + 0]) : 0;
seq_clock_playing = seq_active_project > 0 ? floor(gmem[seq_clock_base + 1]) : 0;
seq_clock_bar = seq_active_project > 0 ? floor(gmem[seq_clock_base + 2]) : 0;
seq_clock_step = seq_active_project > 0 ? floor(gmem[seq_clock_base + 3]) : 0;
seq_clock_config_version = seq_active_project > 0 ? floor(gmem[seq_clock_base + 4]) : 0;
seq_clock_available = seq_active_project > 0 && seq_clock_heartbeat > 0;

seq_main_config_base = 600 + ((max(1, seq_active_project) - 1) * 4);
seq_main_config_version = seq_active_project > 0 ? floor(gmem[seq_main_config_base + 0]) : 0;
seq_main_clock_ready = seq_clock_available && seq_main_config_version > 0 &&
    seq_clock_config_version == seq_main_config_version;

seq_playing = seq_clock_available ? seq_clock_playing : ((play_state & 1) == 1);
seq_current_bar = seq_clock_available ? seq_clock_bar : 0;
seq_current_step = seq_clock_available ? seq_clock_step : 0;

seq_mode == 2 ? (
    seq_playing = seq_main_clock_ready ? seq_clock_playing : 0;
    seq_current_bar = seq_main_clock_ready ? seq_clock_bar : 0;
    seq_current_step = seq_main_clock_ready ? seq_clock_step : 0;
);

// Fallback before a subproject clock has published its first block.
seq_mode != 2 && !seq_clock_available && seq_playing && seq_enabled && seq_region_bars > 0 ? (
    seq_measure_qn = max(0.000001, ts_num * 4 / ts_denom);
    seq_relative_qn = beat_position - seq_region_start_qn;
    seq_relative_qn >= 0 ? (
        seq_absolute_bar = floor(seq_relative_qn / seq_measure_qn);
        seq_current_bar = (seq_absolute_bar % seq_region_bars) + 1;
        seq_within_bar_qn = seq_relative_qn - (seq_absolute_bar * seq_measure_qn);
        seq_current_step = floor(seq_within_bar_qn / 0.25) + 1;
        seq_current_step = max(1, min(seq_display_active_steps, seq_current_step));
    );
);

seq_mode == 1 && seq_current_bar != seq_selected_bar ? seq_current_step = 0;

seq_changed =
    seq_enabled != seq_last_enabled ||
    seq_mode != seq_last_mode ||
    seq_selected_bar != seq_last_bar ||
    seq_region_bars != seq_last_region_bars ||
    seq_current_bar != seq_last_current_bar ||
    seq_pattern_version != seq_last_pattern_version ||
    seq_force_version != seq_last_force_version ||
    seq_current_step != seq_last_step ||
    seq_playing != seq_last_playing ||
    seq_active_project != seq_last_active_project ||
    seq_main_config_version != seq_last_main_config_version ||
    seq_clock_config_version != seq_last_clock_config_version ||
    seq_display_active_steps != seq_last_active_steps;

seq_enabled && seq_changed ? (
    seq_mode == 2 ? (
        seq_send_main_display(seq_region_bars, max(0, seq_last_region_bars), seq_current_bar, seq_playing);
    ) : (
        seq_send_display(seq_selected_bar, seq_current_step, seq_playing);
    );
);

seq_last_enabled = seq_enabled;
seq_last_mode = seq_mode;
seq_last_bar = seq_selected_bar;
seq_last_region_bars = seq_region_bars;
seq_last_current_bar = seq_current_bar;
seq_last_pattern_version = seq_pattern_version;
seq_last_force_version = seq_force_version;
seq_last_step = seq_current_step;
seq_last_playing = seq_playing;
seq_last_clock_heartbeat = seq_clock_heartbeat;
seq_last_active_project = seq_active_project;
seq_last_main_config_version = seq_main_config_version;
seq_last_clock_config_version = seq_clock_config_version;
seq_last_active_steps = seq_display_active_steps;

