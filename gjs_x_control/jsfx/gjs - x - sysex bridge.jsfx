desc:GJS - X - SysEx Bridge
options:gmem=GJS_X_BRIDGE
import gjs_x_renderer.jsfx-inc

// ============================================================
// gmem-indeling
//
// gmem[0] = sequence
// gmem[1] = command
// gmem[2] = laatst bevestigde sequence
//
// Command 3:
// gmem[3] = LED-index / MIDI-noot
// gmem[4] = rood   0-127
// gmem[5] = groen  0-127
// gmem[6] = blauw  0-127
// ============================================================


@init

last_sequence = -1;

// Twee losse geheugenbuffers voor SysEx
buf_midi = 0;
buf_daw = 128;



// ============================================================
// Screen-7 performance rendering (owned by the hardware bridge)
// ============================================================
PERFORMANCE_SCREEN_SLOT = 100;
PERF_LAYOUT_SLOT = 1200;
PERF_OCTAVE_SLOT = 1201;
PERF_REDRAW_SLOT = 1202;
PERF_FEEDBACK_SEQ_SLOT = 1203;
PERF_FEEDBACK_NOTE_SLOT = 1204;
PERF_FEEDBACK_STATE_SLOT = 1205;
last_perf_layout = -1;
last_perf_octave = 999;
last_perf_redraw = -1;
last_perf_feedback_seq = -1;

// Screen 2/3 semantic control renderer.
MIX_RENDER_SCREEN_SLOT = 3200;
MIX_RENDER_VERSION_SLOT = 3201;
MIX_RENDER_CONTROL_BASE = 3202;
MIX_RENDER_CONTROL_STRIDE = 6;

MIX_RENDER_EVENT_SEQ_SLOT = 3250;
MIX_RENDER_EVENT_SCREEN_SLOT = 3251;
MIX_RENDER_EVENT_INDEX_SLOT = 3252;
MIX_RENDER_EVENT_DATA_BASE = 3253;

last_mix_render_version = -1;
last_mix_render_event_seq = -1;

// Screen 6 sequencer rows 7/8.
SEQ_RENDER_VERSION_SLOT = 3300;
SEQ_RENDER_ENABLED_SLOT = 3301;
SEQ_RENDER_RGB_BASE = 3302;
last_seq_render_version = -1;

MAINBAR_RENDER_VERSION_SLOT = 3350;
MAINBAR_RENDER_ENABLED_SLOT = 3351;
MAINBAR_RENDER_COUNT_SLOT = 3352;
MAINBAR_RENDER_RGB_BASE = 3353;
last_mainbar_render_version = -1;

// Static Lua screens.
CURRENT_SCREEN_SLOT = 3499;
STATIC_RENDER_SCREEN_SLOT = 3500;
STATIC_RENDER_VERSION_SLOT = 3501;
STATIC_RENDER_RGB_BASE = 3502;
last_static_render_version = -1;

// Sidebar/navigation CC LED state buffer.
SIDEBAR_STATE_VERSION_SLOT = 3700;
SIDEBAR_STATE_BASE = 3710;
last_sidebar_state_version = -1;

function perf_clamp(v) ( max(0,min(127,floor(v))); );

function perf_write_rgb(buffer,target,led,r,g,b) (
    buffer[target]=$x03;
    buffer[target+1]=perf_clamp(led);
    buffer[target+2]=perf_clamp(r);
    buffer[target+3]=perf_clamp(g);
    buffer[target+4]=perf_clamp(b);
);

function perf_drum_rgb(note,component) local(row,col,r,g,b) (
    row=floor(note/10); col=note%10; r=0; g=0; b=0;
    (row==7 && (col==4 || col==5)) || (row==6 && (col==4 || col==5)) ? (r=127;b=80;);
    row==5 ? (
        col==2 || col==7 ? (r=127;g=127;b=127;);
        col==3 || col==6 ? (r=127;g=110;);
        col==4 ? (r=127;b=80;);
        col==5 ? (r=60;b=127;);
    );
    row==4 ? (
        col==2 || col==7 ? g=127;
        col==3 || col==6 ? b=127;
        col==4 || col==5 ? (g=70;b=127;);
    );
    row==3 ? (
        col==2 || col==7 ? (r=127;g=40;);
        col==4 || col==5 ? (r=127;g=110;);
    );
    row==2 ? (
        col==2 || col==7 ? (r=75;g=25;b=127;);
        col==4 || col==5 ? (r=127;g=40;);
    );
    row==1 && (col==4 || col==5) ? r=55;
    component==1?r:component==2?g:b;
);

function perf_piano_key(note) local(row,col,pair,semi,valid) (
    row=floor(note/10); col=note%10; pair=floor((row-1)/2); semi=-1; valid=0;
    row%2==1 ? (
        col==1?semi=0:col==2?semi=2:col==3?semi=4:col==4?semi=5:col==5?semi=7:col==6?semi=9:col==7?semi=11:col==8?semi=12;
        valid=1;
    ) : (
        col==2?semi=1:col==3?semi=3:col==5?semi=6:col==6?semi=8:col==7?semi=10;
        semi>=0 ? valid=1;
    );
    valid ? pair*12+semi : -1;
);

function perf_send_one(led,r,g,b) local(row,col) (
    row=floor(led/10);
    col=led%10;

    row>=1 && row<=8 && col>=1 && col<=8 ? (
        renderer_pad(row,col,r,g,b);
        renderer_flush();
    );
);

function perf_base_rgb(note,layout,component) local(k,r,g,b) (
    r=0;g=0;b=0;
    layout==1 ? (r=perf_drum_rgb(note,1);g=perf_drum_rgb(note,2);b=perf_drum_rgb(note,3);) :
    layout==2 ? (
        note==41 || note==48 ? (r=100;g=65;b=0;) : (
            note==21 || note==28 ? (r=0;g=100;b=0;) : (
                k=perf_piano_key(note); k>=0 ? (b=22;);
            );
        );
    );
    component==1?r:component==2?g:b;
);

function perf_draw_layout(layout) local(i,row,col,n,r,g,b) (
    renderer_clear();

    i=0;
    loop(64,
        row=floor(i/8)+1;
        col=(i%8)+1;
        n=row*10+col;

        r=perf_base_rgb(n,layout,1);
        g=perf_base_rgb(n,layout,2);
        b=perf_base_rgb(n,layout,3);

        renderer_pad(row,col,r,g,b);
        i+=1;
    );

    renderer_flush();
);


function mix_draw_controls(screen)
local(i,base,v1,v2,centered,r,g,b,row) (
    renderer_clear();

    i = 0;
    loop(8,
        base = MIX_RENDER_CONTROL_BASE + i * MIX_RENDER_CONTROL_STRIDE;
        v1 = floor(gmem[base + 0]);
        v2 = floor(gmem[base + 1]);
        centered = floor(gmem[base + 2]);
        r = gmem[base + 3];
        g = gmem[base + 4];
        b = gmem[base + 5];

        screen == 2 ? (
            renderer_vertical_fader_state(
                i + 1,
                v1,
                v2,
                r,g,b
            );
        ) : screen == 3 ? (
            row = 8 - i;
            renderer_balance_state(
                row,
                v1,
                v2,
                centered,
                r,g,b
            );
        );

        i += 1;
    );

    renderer_flush();
);

function mix_draw_one_control(screen,index)
local(v1,v2,centered,r,g,b,row) (
    v1 = floor(gmem[MIX_RENDER_EVENT_DATA_BASE + 0]);
    v2 = floor(gmem[MIX_RENDER_EVENT_DATA_BASE + 1]);
    centered = floor(gmem[MIX_RENDER_EVENT_DATA_BASE + 2]);
    r = gmem[MIX_RENDER_EVENT_DATA_BASE + 3];
    g = gmem[MIX_RENDER_EVENT_DATA_BASE + 4];
    b = gmem[MIX_RENDER_EVENT_DATA_BASE + 5];

    screen == 2 ? (
        renderer_vertical_fader_state(index,v1,v2,r,g,b);
    ) : screen == 3 ? (
        row = 9 - index;
        renderer_balance_state(row,v1,v2,centered,r,g,b);
    );

    renderer_flush();
);



function seq_draw_rows() local(i,row,col,source,r,g,b) (
    i = 0;
    loop(16,
        i < 8 ? (
            row = 8;
            col = i + 1;
        ) : (
            row = 7;
            col = i - 7;
        );

        source = SEQ_RENDER_RGB_BASE + i * 3;
        r = gmem[source + 0];
        g = gmem[source + 1];
        b = gmem[source + 2];

        renderer_pad(row,col,r,g,b);
        i += 1;
    );

    renderer_flush_rows(7,8);
);



function mainbar_draw_rows() local(i,row,col,source,r,g,b) (
    i = 0;
    loop(16,
        i < 8 ? (
            row = 8;
            col = i + 1;
        ) : (
            row = 7;
            col = i - 7;
        );

        source = MAINBAR_RENDER_RGB_BASE + i * 3;
        r = gmem[source + 0];
        g = gmem[source + 1];
        b = gmem[source + 2];

        renderer_pad(row,col,r,g,b);
        i += 1;
    );

    renderer_flush_rows(7,8);
);



function static_draw_frame(screen) local(i,row,col,source,r,g,b) (
    renderer_clear();

    i = 0;
    loop(64,
        row = floor(i / 8) + 1;
        col = (i % 8) + 1;
        source = STATIC_RENDER_RGB_BASE + i * 3;

        r = gmem[source + 0];
        g = gmem[source + 1];
        b = gmem[source + 2];

        renderer_pad(row,col,r,g,b);
        i += 1;
    );

    screen == 6 ? renderer_flush_rows(1,6) : renderer_flush();
);


@block

sequence = floor(gmem[0]);

sequence != last_sequence ? (
    last_sequence = sequence;
    command = floor(gmem[1]);


    // ========================================================
    // Command 1: Programmer Mode
    // ========================================================

    command == 1 ? (

        // Normale MIDI-interface:
        // F0 00 20 29 02 0D 0E 01 F7

        buf_midi[0] = $xF0;
        buf_midi[1] = $x00;
        buf_midi[2] = $x20;
        buf_midi[3] = $x29;
        buf_midi[4] = $x02;
        buf_midi[5] = $x0D;
        buf_midi[6] = $x0E;
        buf_midi[7] = $x01;
        buf_midi[8] = $xF7;

        midisend_buf(0, buf_midi, 9);


        // DAW-interface:
        // F0 00 20 29 02 0C 0E 01 F7

        buf_daw[0] = $xF0;
        buf_daw[1] = $x00;
        buf_daw[2] = $x20;
        buf_daw[3] = $x29;
        buf_daw[4] = $x02;
        buf_daw[5] = $x0C;
        buf_daw[6] = $x0E;
        buf_daw[7] = $x01;
        buf_daw[8] = $xF7;

        midisend_buf(0, buf_daw, 9);

        gmem[2] = sequence;
    );


    // Legacy RGB commands 2-5 removed: all matrix output now uses the central renderer.
);

// Screen 2/3 mixer framebuffer. This bridge is the only hardware writer.
sidebar_state_version=floor(gmem[SIDEBAR_STATE_VERSION_SLOT]);
sidebar_state_version!=last_sidebar_state_version ? (
    // Right sidebar screen buttons: 89,79,69,59,49,39,29,19
    sidebar_i=0;
    loop(8,
        sidebar_cc=89-(sidebar_i*10);
        sidebar_value=floor(gmem[SIDEBAR_STATE_BASE+sidebar_cc]);
        sidebar_value=max(0,min(127,sidebar_value));
        midisend(0,$xB0,sidebar_cc | (sidebar_value*256));
        sidebar_i+=1;
    );

    // Top navigation buttons: 91..94. Always send zero too, so an old
    // navigation LED cannot remain lit after the state changes.
    sidebar_cc=91;
    loop(4,
        sidebar_value=floor(gmem[SIDEBAR_STATE_BASE+sidebar_cc]);
        sidebar_value=max(0,min(127,sidebar_value));
        midisend(0,$xB0,sidebar_cc | (sidebar_value*256));
        sidebar_cc+=1;
    );

    last_sidebar_state_version=sidebar_state_version;
);

static_render_version=floor(gmem[STATIC_RENDER_VERSION_SLOT]);
static_render_version!=last_static_render_version ? (
    static_render_screen=floor(gmem[STATIC_RENDER_SCREEN_SLOT]);

    (
        static_render_screen==0 ||
        static_render_screen==1 ||
        static_render_screen==4 ||
        static_render_screen==5 ||
        static_render_screen==6
    ) ? (
        static_draw_frame(static_render_screen);
    );

    last_static_render_version=static_render_version;
);

mainbar_render_version=floor(gmem[MAINBAR_RENDER_VERSION_SLOT]);
mainbar_render_version!=last_mainbar_render_version ? (
    mainbar_render_enabled=floor(gmem[MAINBAR_RENDER_ENABLED_SLOT]);

    current_screen=floor(gmem[CURRENT_SCREEN_SLOT]);

    mainbar_render_enabled==1 && current_screen==0 ? (
        mainbar_draw_rows();
    );

    last_mainbar_render_version=mainbar_render_version;
);

seq_render_version=floor(gmem[SEQ_RENDER_VERSION_SLOT]);
seq_render_version!=last_seq_render_version ? (
    seq_render_enabled=floor(gmem[SEQ_RENDER_ENABLED_SLOT]);

    current_screen=floor(gmem[CURRENT_SCREEN_SLOT]);

    seq_render_enabled==1 && current_screen==6 ? (
        seq_draw_rows();
    );

    last_seq_render_version=seq_render_version;
);

mix_render_event_seq=floor(gmem[MIX_RENDER_EVENT_SEQ_SLOT]);
mix_render_event_seq!=last_mix_render_event_seq ? (
    mix_render_event_screen=floor(gmem[MIX_RENDER_EVENT_SCREEN_SLOT]);
    mix_render_event_index=floor(gmem[MIX_RENDER_EVENT_INDEX_SLOT]);

    (mix_render_event_screen==2 || mix_render_event_screen==3) &&
    mix_render_event_index>=1 && mix_render_event_index<=8 ? (
        mix_draw_one_control(
            mix_render_event_screen,
            mix_render_event_index
        );
    );

    last_mix_render_event_seq=mix_render_event_seq;
);

mix_render_screen=floor(gmem[MIX_RENDER_SCREEN_SLOT]);
mix_render_version=floor(gmem[MIX_RENDER_VERSION_SLOT]);

(mix_render_screen==2 || mix_render_screen==3) &&
mix_render_version!=last_mix_render_version ? (
    mix_draw_controls(mix_render_screen);
    last_mix_render_version=mix_render_version;
);

// Screen-7 layout and feedback are sent by this JSFX because this bridge is
// the one routed to the Launchpad hardware outputs.
perf_screen = floor(gmem[PERFORMANCE_SCREEN_SLOT]) == 1;
perf_layout = perf_screen ? floor(gmem[PERF_LAYOUT_SLOT]) : 0;
perf_octave = floor(gmem[PERF_OCTAVE_SLOT]);
perf_redraw = floor(gmem[PERF_REDRAW_SLOT]);

(perf_layout != last_perf_layout || perf_octave != last_perf_octave || perf_redraw != last_perf_redraw) ? (
    // IMPORTANT: never clear the 8x8 matrix when leaving performance mode.
    // Lua has already drawn (or is about to draw) the destination screen, and
    // a delayed perf_draw_layout(0) would race it and blank that screen.
    perf_screen ? perf_draw_layout(perf_layout);
    last_perf_layout=perf_layout;last_perf_octave=perf_octave;last_perf_redraw=perf_redraw;
);

perf_feedback_seq=floor(gmem[PERF_FEEDBACK_SEQ_SLOT]);
perf_feedback_seq != last_perf_feedback_seq ? (
    last_perf_feedback_seq=perf_feedback_seq;
    // Ignore stale press/release feedback after screen 7 has been left.
    perf_screen ? (
        perf_note=floor(gmem[PERF_FEEDBACK_NOTE_SLOT]);
        perf_pressed=floor(gmem[PERF_FEEDBACK_STATE_SLOT]);
        perf_pressed ? perf_send_one(perf_note,127,0,0) : (
            perf_send_one(perf_note,
                perf_base_rgb(perf_note,perf_layout,1),
                perf_base_rgb(perf_note,perf_layout,2),
                perf_base_rgb(perf_note,perf_layout,3));
        );
    );
);

