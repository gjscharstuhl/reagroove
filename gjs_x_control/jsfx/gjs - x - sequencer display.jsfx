desc:GJS - X - Sequencer Display
options:gmem=GJS_X_BRIDGE

// ============================================================
// ReaGroove sequencer display for Launchpad X
//
// This JSFX owns only Launchpad rows 7 and 8.
// Lua writes the pattern/state into gmem; JSFX draws the moving
// playhead at audio-block speed.
//
// gmem layout
// ------------------------------------------------------------
// Sequencer display uses gmem base slot 300.
// gmem[300] = display mode: 0 off, 1 sequencer, 2 mainscreen bars
// gmem[301] = selected bar, 1-based
// gmem[302] = selected region start in quarter notes
// gmem[303] = selected region length in bars
// gmem[304] = pattern version (increment after Lua changes notes)
// gmem[305] = force redraw version
// gmem[306] = active sixteenth-note steps in selected measure (1..16)
// gmem[332] = active subproject number (1..8)
//
// gmem[316] .. gmem[331] = velocity for steps 1 .. 16
//                         0 means no selected note on that step
//
// The first version shows one selected drum pitch at a time.
// Lua will refresh these sixteen values when the selected drum
// note, region, armed track or selected bar changes.
// ============================================================

slider1:0<0,1,1{Off,On}>Local test enable
slider2:1<1,16,1>Local test bar
slider3:0<0,65535,1>Local test pattern mask

@init

gmem_base = 300;

// Central bridge renderer event for screen-6 rows 7/8.
// 3300 = generation, 3301 = enabled
// 3302..3349 = 16 RGB triplets
SEQ_RENDER_VERSION_SLOT = 3300;
SEQ_RENDER_ENABLED_SLOT = 3301;
SEQ_RENDER_RGB_BASE = 3302;
seq_render_version = floor(gmem[SEQ_RENDER_VERSION_SLOT]);

MAINBAR_RENDER_VERSION_SLOT = 3350;
MAINBAR_RENDER_ENABLED_SLOT = 3351;
MAINBAR_RENDER_COUNT_SLOT = 3352;
MAINBAR_RENDER_RGB_BASE = 3353;
mainbar_render_version = floor(gmem[MAINBAR_RENDER_VERSION_SLOT]);

last_enabled = -1;
last_mode = -1;
last_bar = -1;
last_pattern_version = -1;
last_force_version = -1;
last_step = -2;
last_playing = -1;
last_clock_heartbeat = -1;
last_active_project = -1;
last_region_bars = -1;
last_current_bar = -1;
last_active_steps = -1;

buf_midi = 0;
buf_daw = 256;

function clamp127(value) (
    max(0, min(127, floor(value)));
);

function step_led(step) local(row, col) (
    step <= 8 ? (
        row = 8;
        col = step;
    ) : (
        row = 7;
        col = step - 8;
    );

    row * 10 + col;
);

function get_background(bar, component) local(cycle) (
    cycle = ((bar - 1) % 4) + 1;

    // Screen 6: dark green, orange, blue and purple.
    cycle == 1 ? (
        component == 1 ? 0 : component == 2 ? 10 : 0;
    ) : cycle == 2 ? (
        component == 1 ? 12 : component == 2 ? 3 : 0;
    ) : cycle == 3 ? (
        // Slightly lighter blue than the note-selection block.
        component == 1 ? 0 : component == 2 ? 4 : 20;
    ) : (
        component == 1 ? 8 : component == 2 ? 0 : 18;
    );
);

function get_playhead(bar, component) local(cycle) (
    cycle = ((bar - 1) % 4) + 1;

    // Screen 6: bright green, orange, blue and purple.
    cycle == 1 ? (
        component == 1 ? 0 : component == 2 ? 127 : 0;
    ) : cycle == 2 ? (
        component == 1 ? 127 : component == 2 ? 35 : 0;
    ) : cycle == 3 ? (
        component == 1 ? 0 : component == 2 ? 45 : 127;
    ) : (
        component == 1 ? 75 : component == 2 ? 25 : 127;
    );
);

function write_rgb_spec(buffer, target, led, red, green, blue) (
    buffer[target + 0] = $x03;
    buffer[target + 1] = clamp127(led);
    buffer[target + 2] = clamp127(red);
    buffer[target + 3] = clamp127(green);
    buffer[target + 4] = clamp127(blue);
);

function publish_sequence_display(selected_bar, current_step, playing, use_gmem)
local(i, velocity, red, green, blue, note_here, other_note_here,
      playhead_here, mask, active_steps, target) (

    mask = floor(slider3);
    active_steps =
        use_gmem ? max(1, min(16, floor(gmem[gmem_base + 6]))) : 16;

    i = 0;
    loop(16,
        use_gmem ? (
            velocity = floor(gmem[gmem_base + 16 + i]);
        ) : (
            velocity = (mask & (1 << i)) ? 127 : 0;
        );

        other_note_here = velocity >= 256;
        note_here = velocity > 0 && velocity < 256;
        playhead_here = playing && current_step == i + 1;

        i + 1 > active_steps ? (
            red = 0; green = 0; blue = 0;
            note_here = 0; playhead_here = 0;
        ) : (
            red = get_background(selected_bar, 1);
            green = get_background(selected_bar, 2);
            blue = get_background(selected_bar, 3);
        );

        other_note_here && i + 1 <= active_steps ? (
            red = min(127, get_background(selected_bar, 1) * 3);
            green = min(127, get_background(selected_bar, 2) * 3);
            blue = min(127, get_background(selected_bar, 3) * 3);
        );

        note_here ? (
            red = max(30, velocity);
            green = 0;
            blue = 0;
        );

        playhead_here ? (
            note_here ? (
                red = 127;
                green = 127;
                blue = 127;
            ) : (
                red = get_playhead(selected_bar, 1);
                green = get_playhead(selected_bar, 2);
                blue = get_playhead(selected_bar, 3);
            );
        );

        target = SEQ_RENDER_RGB_BASE + i * 3;
        gmem[target + 0] = clamp127(red);
        gmem[target + 1] = clamp127(green);
        gmem[target + 2] = clamp127(blue);

        i += 1;
    );

    gmem[SEQ_RENDER_ENABLED_SLOT] = 1;
    seq_render_version += 1;
    gmem[SEQ_RENDER_VERSION_SLOT] = seq_render_version;
);

function disable_sequence_renderer() (
    gmem[SEQ_RENDER_ENABLED_SLOT] = 0;
    seq_render_version += 1;
    gmem[SEQ_RENDER_VERSION_SLOT] = seq_render_version;
);

function publish_main_display(region_bars, previous_region_bars, current_bar, playing)
local(i,count,red,green,blue,active_bar,target) (
    count = max(region_bars, previous_region_bars);
    count = max(0, min(16, count));

    i = 0;
    loop(16,
        red = 32;
        green = 32;
        blue = 32;

        i < count ? (
            active_bar = i + 1;

            active_bar <= region_bars ? (
                red = 83;
                green = 20;
                blue = 20;

                playing && active_bar == current_bar ? (
                    red = 127;
                    green = 0;
                    blue = 0;
                );
            );
        );

        target = MAINBAR_RENDER_RGB_BASE + i * 3;
        gmem[target + 0] = clamp127(red);
        gmem[target + 1] = clamp127(green);
        gmem[target + 2] = clamp127(blue);

        i += 1;
    );

    gmem[MAINBAR_RENDER_COUNT_SLOT] = count;
    gmem[MAINBAR_RENDER_ENABLED_SLOT] = count > 0 ? 1 : 0;

    mainbar_render_version += 1;
    gmem[MAINBAR_RENDER_VERSION_SLOT] = mainbar_render_version;
);

function disable_mainbar_renderer() (
    gmem[MAINBAR_RENDER_ENABLED_SLOT] = 0;
    mainbar_render_version += 1;
    gmem[MAINBAR_RENDER_VERSION_SLOT] = mainbar_render_version;
);


@slider

// Force a refresh when testing with sliders.
last_force_version = -1;

@block

external_mode = floor(gmem[gmem_base + 0]);
use_gmem = external_mode > 0;
mode = use_gmem ? external_mode : (slider1 >= 0.5 ? 1 : 0);
enabled = mode > 0;

selected_bar = use_gmem ? max(1, floor(gmem[gmem_base + 1])) : floor(slider2);
region_start_qn = use_gmem ? gmem[gmem_base + 2] : 0;
region_bars = use_gmem ? max(0, floor(gmem[gmem_base + 3])) : max(1, floor(slider2));
pattern_version = use_gmem ? floor(gmem[gmem_base + 4]) : floor(slider3);
force_version = use_gmem ? floor(gmem[gmem_base + 5]) : floor(slider3);
display_active_steps = use_gmem ? max(1, min(16, floor(gmem[gmem_base + 6]))) : 16;

// Prefer the clock calculated inside the active subproject. That JSFX
// sees the correct local beat_position, tempo map and time signature.
active_project = max(0, min(8, floor(gmem[332])));
clock_base = 340 + ((max(1, active_project) - 1) * 4);
clock_heartbeat = active_project > 0 ? floor(gmem[clock_base + 0]) : 0;
clock_playing = active_project > 0 ? floor(gmem[clock_base + 1]) : 0;
clock_bar = active_project > 0 ? floor(gmem[clock_base + 2]) : 0;
clock_step = active_project > 0 ? floor(gmem[clock_base + 3]) : 0;
clock_available = active_project > 0 && clock_heartbeat > 0;

playing = clock_available ? clock_playing : ((play_state & 1) == 1);
current_bar = clock_available ? clock_bar : 0;
current_step = clock_available ? clock_step : 0;

// Fallback keeps the display usable before the subproject clock has written
// its first audio block, or in a project that has no clock JSFX yet.
!clock_available && playing && enabled && region_bars > 0 ? (
    measure_qn = max(0.000001, ts_num * 4 / ts_denom);
    relative_qn = beat_position - region_start_qn;

    relative_qn >= 0 ? (
        absolute_bar = floor(relative_qn / measure_qn);
        current_bar = (absolute_bar % region_bars) + 1;
        within_bar_qn = relative_qn - (absolute_bar * measure_qn);
        current_step = floor(within_bar_qn / 0.25) + 1;
        current_step = max(1, min(display_active_steps, current_step));
    );
);

// Screen 6 shows its playhead only while the selected edit bar is playing.
mode == 1 && current_bar != selected_bar ? current_step = 0;

changed =
    enabled != last_enabled ||
    mode != last_mode ||
    selected_bar != last_bar ||
    region_bars != last_region_bars ||
    current_bar != last_current_bar ||
    pattern_version != last_pattern_version ||
    force_version != last_force_version ||
    current_step != last_step ||
    playing != last_playing ||
    active_project != last_active_project ||
    display_active_steps != last_active_steps;

enabled && changed ? (
    mode == 2 ? (
        publish_main_display(
            region_bars,
            max(0, last_region_bars),
            current_bar,
            playing
        );
    ) : (
        publish_sequence_display(
            selected_bar,
            current_step,
            playing,
            use_gmem
        );
    );
);

(!enabled || mode != 1) &&
(last_enabled == 1 && last_mode == 1) ? (
    disable_sequence_renderer();
);

(!enabled || mode != 2) &&
(last_enabled == 1 && last_mode == 2) ? (
    disable_mainbar_renderer();
);

last_enabled = enabled;
last_mode = mode;
last_bar = selected_bar;
last_region_bars = region_bars;
last_current_bar = current_bar;
last_pattern_version = pattern_version;
last_force_version = force_version;
last_step = current_step;
last_playing = playing;
last_clock_heartbeat = clock_heartbeat;
last_active_project = active_project;
last_active_steps = display_active_steps;




